# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Stape via BigQuery
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=stape_data
BIGQUERY_TABLE=dashboard_events
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json

# Optional. Total ad + marketing spend for the selected range, in USD.
# Used only for MER (Shopify revenue ÷ spend). Leave blank if you do not want to enter spend.
# MARKETING_SPEND_USD=
