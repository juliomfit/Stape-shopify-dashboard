# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Stape via BigQuery
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=stape_data
BIGQUERY_TABLE=dashboard_events
BIGQUERY_LOCATION=US

# Local only: path to the JSON key file (do not commit the file).
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json

# Vercel: paste the full service-account JSON as one line (server only).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Required on Vercel. Leave empty on localhost.
# DASHBOARD_PASSWORD=

# Optional durable spend JSON on Vercel if cookie storage is too small.
# ADS_PASTE_JSON=

# After the Facebook app appeal is approved:
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/meta/callback

# Until then, paste or CSV on True Performance.
# META_SPEND=
# META_PURCHASES=
# META_REVENUE=

# Google Ads (paste Ads Manager totals for the same date range — no fake defaults).
# GOOGLE_ADS_SPEND=
# GOOGLE_ADS_PURCHASES=
# GOOGLE_ADS_REVENUE=
