# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Optional HMAC override for /api/shopify/webhooks (defaults to CLIENT_SECRET)
# SHOPIFY_WEBHOOK_SECRET=

# Stape via BigQuery
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=stape_data
BIGQUERY_TABLE=dashboard_events
BIGQUERY_LOCATION=US
# Platform warehouse (Meta insights, sync_runs). Run bigquery/platform/00_schema.sql
# BIGQUERY_PLATFORM_DATASET=goodsnova_platform

# Local only: path to the JSON key file (do not commit the file).
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json

# Vercel: paste the full service-account JSON as one line (server only).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Required on Vercel. Leave empty on localhost.
# DASHBOARD_PASSWORD=

# Protects /api/cron/sync. Vercel Cron sends Authorization: Bearer CRON_SECRET
# CRON_SECRET=

# Optional durable spend JSON on Vercel if cookie storage is too small.
# ADS_PASTE_JSON=

# Meta Marketing API (Integrations → Connect Meta Ads)
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/meta/callback
# META_OAUTH_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/meta/callback
# META_API_VERSION=v21.0
# Until OAuth works, paste or CSV on True Performance / Integrations.
# META_SPEND=
# META_PURCHASES=
# META_REVENUE=
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=

# Google Ads (paste Ads Manager totals for the same date range — no fake defaults).
# GOOGLE_ADS_SPEND=
# GOOGLE_ADS_PURCHASES=
# GOOGLE_ADS_REVENUE=

# Optional GA4 Data API (same service account JSON as BigQuery).
# Service account needs Analyst on the GA4 property (Admin API if the UI rejects .iam.gserviceaccount.com).
# Enable Analytics Data API on the GCP project in the service account JSON (client_email's project).
# GA4_PROPERTY_ID=461373366
# GA4_STREAM_ID=
# GA4_MEASUREMENT_ID=G-XXXX

# Optional GPT. Dashboard works without this.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Flyweel MCP (production Meta data bridge). Ignore Cursor/Claude mcp.json.
# Create a key at app.flyweel.co → Settings → API & MCP (fwl_ + 64 chars).
# Put it on Vercel only. Do not commit the key. Do not use NEXT_PUBLIC_.
# FLYWEEL_API_KEY=
# FLYWEEL_MCP_URL=https://api.flyweel.co/functions/v1/mcp-server/mcp
# FLYWEEL_META_ACCOUNT_ID=
# META_ADS_PROVIDER=auto
# Optional: request Flyweel trigger_sync before each ingest (usually unnecessary; Flyweel auto-refreshes if >15 min stale).
# FLYWEEL_TRIGGER_SYNC=

# REPORTING_CURRENCY=USD
