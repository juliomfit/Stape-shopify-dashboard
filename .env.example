# Shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Stape via BigQuery
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=stape_data
BIGQUERY_TABLE=dashboard_events
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-service-account.json

# Optional. Total ad spend if Meta/Google are not connected, in USD.
# MARKETING_SPEND_USD=

# Meta Ads. Prefer API. Or paste Ads Manager totals for the selected date range.
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_SPEND=
# META_PURCHASES=
# META_REVENUE=

# Google Ads (paste Ads Manager totals for the same date range — no fake defaults).
# GOOGLE_ADS_SPEND=
# GOOGLE_ADS_PURCHASES=
# GOOGLE_ADS_REVENUE=
